{
  "name": "@elvatis_com/aahp-runner",
  "version": "0.4.0",
  "description": "Autonomous agent runner for AAHP v3 projects - spawns Claude agents to work through tasks across all repos",
  "license": "Apache-2.0",
  "author": "Elvatis <emre.kohler@elvatis.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/homeofe/aahp-runner.git"
  },
  "keywords": [
    "aahp",
    "agent",
    "autonomous",
    "claude",
    "ai",
    "runner",
    "cli",
    "task-runner"
  ],
  "type": "module",
  "types": "dist/types.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "aahp": "dist/cli.js",
    "aahp-runner": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p ./",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@elvatis_com/aahp": "3.8.1",
    "@types/node": "^26.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.4"
  }
}
