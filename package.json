{
  "name": "aahp-runner",
  "version": "0.1.0",
  "description": "Autonomous agent runner for AAHP v3 projects - spawns Claude agents to work through tasks across all repos",
  "license": "MIT",
  "author": "elvatis",
  "repository": {
    "type": "git",
    "url": "https://github.com/homeofe/aahp-runner.git"
  },
  "keywords": [
    "aahp",
    "agent",
    "autonomous",
    "claude",
    "ai",
    "runner",
    "cli",
    "task-runner"
  ],
  "type": "module",
  "types": "dist/types.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "aahp": "./dist/cli.js",
    "aahp-runner": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p ./",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
