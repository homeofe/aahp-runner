{
  "name": "aahp-dashboard",
  "displayName": "AAHP Dashboard",
  "description": "Monitor AAHP agent runs, metrics, and resource usage directly in VS Code",
  "version": "0.2.0",
  "publisher": "elvatis",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aahpDashboard.openDashboard",
        "title": "AAHP: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "aahpDashboard.showMetrics",
        "title": "AAHP: Show Metrics",
        "icon": "$(graph)"
      },
      {
        "command": "aahpDashboard.refreshDashboard",
        "title": "AAHP: Refresh Dashboard",
        "icon": "$(refresh)"
      },
      {
        "command": "aahpDashboard.fixTask",
        "title": "AAHP: Fix Task with Claude",
        "icon": "$(tools)"
      },
      {
        "command": "aahpDashboard.fixAllTasks",
        "title": "AAHP: Fix All Open Tasks",
        "icon": "$(run-all)"
      },
      {
        "command": "aahpDashboard.runProject",
        "title": "AAHP: Run Agent on Project",
        "icon": "$(play)"
      },
      {
        "command": "aahpDashboard.openProjectFolder",
        "title": "AAHP: Open Project Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aahpDashboard.openManifest",
        "title": "AAHP: Open MANIFEST.json",
        "icon": "$(json)"
      },
      {
        "command": "aahpDashboard.viewLogs",
        "title": "AAHP: View Project Logs",
        "icon": "$(output)"
      }
    ],
    "keybindings": [
      {
        "command": "aahpDashboard.openDashboard",
        "key": "ctrl+alt+a"
      },
      {
        "command": "aahpDashboard.fixAllTasks",
        "key": "ctrl+alt+f"
      },
      {
        "command": "aahpDashboard.refreshDashboard",
        "key": "ctrl+alt+r"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aahpDashboard.openDashboard",
          "when": "view == aahp.agents",
          "group": "navigation"
        },
        {
          "command": "aahpDashboard.refreshDashboard",
          "when": "view == aahp.agents",
          "group": "navigation"
        },
        {
          "command": "aahpDashboard.fixAllTasks",
          "when": "view == aahp.agents",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aahpDashboard.fixTask",
          "when": "viewItem == readyTask",
          "group": "inline"
        },
        {
          "command": "aahpDashboard.runProject",
          "when": "viewItem == aahpProject",
          "group": "inline"
        },
        {
          "command": "aahpDashboard.openProjectFolder",
          "when": "viewItem == aahpProject"
        },
        {
          "command": "aahpDashboard.openManifest",
          "when": "viewItem == aahpProject"
        },
        {
          "command": "aahpDashboard.viewLogs",
          "when": "viewItem == aahpProject"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aahp-explorer",
          "title": "AAHP",
          "icon": "$(robot)"
        }
      ]
    },
    "views": {
      "aahp-explorer": [
        {
          "id": "aahp.agents",
          "name": "Agents & Projects"
        },
        {
          "id": "aahp.metrics",
          "name": "Metrics"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aahp.agents",
        "contents": "Loading AAHP projects...\n[Open Dashboard](command:aahpDashboard.openDashboard)\n[Refresh](command:aahpDashboard.refreshDashboard)\n[Fix All Open Tasks](command:aahpDashboard.fixAllTasks)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.3"
  }
}
